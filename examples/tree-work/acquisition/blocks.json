{
  "schema_version": 1,
  "raw_sha256": "00543bf87fe4c426643286222cb8af87632831b750b9523478f87e3dec77794c",
  "normalized_sha256": "00543bf87fe4c426643286222cb8af87632831b750b9523478f87e3dec77794c",
  "normalization": [
