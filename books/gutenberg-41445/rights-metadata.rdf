    <dcterms:title>Frankenstein; Or, The Modern Prometheus</dcterms:title>
    <pgterms:marc260>$aUnited Kingdom :$bLackington, Hughes, Harding, Mavor, &amp; Jones, $c1818.</pgterms:marc260>
    <dcterms:description>The 1831 edition is also available: eBook #42324</dcterms:description>
